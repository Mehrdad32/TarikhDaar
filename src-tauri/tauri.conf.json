{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TarikhDaar",
  "version": "6.0.0-alpha.5",
  "identifier": "ir.mehrdad32.tarikhdaar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TarikhDaar 6",
        "width": 1120,
        "height": 760,
        "minWidth": 800,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Mehrdad32",
    "category": "Utility",
    "shortDescription": "Offline Persian, Gregorian and Hijri date converter",
    "longDescription": "TarikhDaar is a fast, private and offline-first date converter for Persian (Solar Hijri), Gregorian and Hijri calendars.",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "TarikhDaar",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
